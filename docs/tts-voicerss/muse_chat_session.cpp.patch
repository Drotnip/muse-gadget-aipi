+/*
+ * Splits the reply into chunks of at most TTS_CHUNK_MAX chars, preferring a
+ * sentence end, then a word boundary, and fetches each in turn; the speech
+ * plays as one because every chunk appends to the same buffer. A reply is
+ * at most TEXT_MAX chars, so this is one request for a normal reply and at
+ * most three for the longest.
+ *
+ * Returns true when any audio arrived. If a later chunk fails, the speech
+ * just stops early and the captions carry on; no audio at all leaves
+ * start_tts() to pace the reply silently, as it does with no key set.
+ */
+static bool tts_fetch(const char *text)
+{
+    const char *key = CONFIG_VOICERSS_API_KEY;
+    if (key == nullptr || key[0] == '\0' || text == nullptr) {
+        return false;
+    }
+    s_tts_fed = 0;
+    size_t total = strlen(text);
+    size_t pos = 0;
+    while (pos < total) {
+        size_t len = total - pos;
+        if (len > TTS_CHUNK_MAX) {
+            len = TTS_CHUNK_MAX;
+            /* Back up to a sentence end, else a space, within the chunk. */
+            size_t cut = 0;
+            for (size_t i = len; i > len / 2; i--) {
+                char c = text[pos + i - 1];
+                if (c == '.' || c == '!' || c == '?') {
+                    cut = i;
+                    break;
+                }
+            }
+            if (!cut) {
+                for (size_t i = len; i > len / 2; i--) {
+                    if (text[pos + i - 1] == ' ') {
+                        cut = i;
+                        break;
+                    }
+                }
+            }
+            if (cut) {
+                len = cut;
+            }
+        }
+        if (!tts_fetch_one(key, text + pos, len)) {
+            break;
+        }
+        pos += len;
+        while (pos < total && text[pos] == ' ') {
+            pos++;   /* the next chunk needn't start with the gap */
+        }
+    }
+    return s_tts_fed > 0;
+}
